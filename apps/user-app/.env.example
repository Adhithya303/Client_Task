# Template only. Vite does NOT load this file.
# Copy it to .env.local and fill in the values:
#   Copy-Item .env.example .env.local      (PowerShell)
#   cp .env.example .env.local             (macOS/Linux)
#
# All values below are PUBLIC browser configuration.
# Never put service-account keys, database credentials, or other secrets in VITE_ variables.

# Firebase web app config (Firebase Console -> Project settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public web push key (Project settings -> Cloud Messaging -> Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# FastAPI backend (introduced in Part 3)
VITE_API_BASE_URL=http://localhost:8000
