<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Debug-only build configuration: permits cleartext HTTP for local development -->
    <!-- Supports physical-device LAN addresses (e.g. 10.10.193.219), Android Emulator (10.0.2.2), and localhost -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
